 {
  "file": "ProgramMsg__Menu.msbt",
  "key": "OnlineAttention_Gest",
  "en": "Play online and compete with players from around\nthe world.\n\nOther players will be able to see your nickname and\nin-game appearance, which may be stored on the\ndevices of players with whom you've played online.\n\nCommunity Guidelines apply and can be found on\nNintendo's website. Remember to please treat others\nwith respect while playing online.\n\nNote: Sometimes your opponent will be a CPU.",
  "masked": "Play online and compete with players from around\nthe world.\n\nOther players will be able to see your nickname and\nin-game appearance, which may be stored on the\ndevices of players with whom you've played online.\n\nCommunity Guidelines apply and can be found on\nNintendo's website. Remember to please treat others\nwith respect while playing online.\n\nNote: Sometimes your opponent will be a CPU.",
  "tokens": []
 },
 {
  "file": "ProgramMsg__Menu.msbt",
  "key": "OnlineAttention_NoGest",
  "en": "Play online and compete with players from around\nthe world.\n\nOther players will be able to see your nickname,\nin-game appearance, title, and other play data. Your\nnickname, in-game appearance, and title might be\nstored on the devices of players with whom you've\nplayed in Play Globally.\n\nCommunity Guidelines apply and can be found on\nNintendo's website. Remember to please treat others\nwith respect while playing online.\n\nNote: Sometimes your opponent will be a CPU.",
  "masked": "Play online and compete with players from around\nthe world.\n\nOther players will be able to see your nickname,\nin-game appearance, title, and other play data. Your\nnickname, in-game appearance, and title might be\nstored on the devices of players with whom you've\nplayed in Play Globally.\n\nCommunity Guidelines apply and can be found on\nNintendo's website. Remember to please treat others\nwith respect while playing online.\n\nNote: Sometimes your opponent will be a CPU.",
  "tokens": []
 },
