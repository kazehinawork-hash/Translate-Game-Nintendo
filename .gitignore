# ============================================================
#  Repo CHỈ chứa MÃ NGUỒN (script / công cụ / cấu hình / từ điển).
#  KHÔNG chứa sản phẩm (mod) hay dữ liệu dịch/bóc tách.
# ============================================================

# --- Khoá bản quyền (TUYỆT ĐỐI KHÔNG commit) ---
input/
**/prod.keys
**/titlekeys.txt

# --- Sản phẩm đã build (mod LayeredFS) ---
output/

# --- Dữ liệu từng game (nguồn bóc tách + bản dịch đang làm) ---
#     Giữ trên máy để sửa/tra cứu, KHÔNG đẩy lên git cho nhẹ repo.
#     (Riêng README.md của từng game thì vẫn đẩy — là tài liệu.)
games/*/source/
games/*/translations/
games/*/_misc/

# --- ROM ---
*.nsp
*.xci

# --- Cache / hệ điều hành ---
__pycache__/
*.pyc
.commandcode/
Thumbs.db
desktop.ini

# --- Binary công cụ nặng (tải lại khi cần) ---
*.dll
*.exe
tools/hactool/
tools/hactoolnet/
tools/kuriimu2/
tools/fonts_hades2/
# NGOẠI LỆ: Lato-Regular.ttf là ĐẦU VÀO BẮT BUỘC để build font tiếng Việt cho
# Hogwarts Legacy + Ori (xem tools/check_font_coverage.py, tools/patch_font_ori.py).
# Không có file này thì clone mới KHÔNG build lại được -> phải lưu trong repo.
!tools/fonts_hades2/Lato-Regular.ttf

# .NET build (cong cu C# trong tools/)
bin/
obj/

dump/
